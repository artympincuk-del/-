BOT_TOKEN=your-telegram-bot-token-from-botfather
GROQ_API_KEY=your-groq-api-key
# Optional — only needed for photo editing (kontext model). Get a key at
# https://enter.pollinations.ai/keys and make sure it has a small pollen
# budget (0 budget silently rejects every edit with a 402). Without a key,
# photo editing shows a friendly "unavailable" message; text-to-image
# generation (/image, "нарисуй ...") works regardless.
POLLINATIONS_API_KEY=
FAST_MODEL=openai/gpt-oss-20b
PREMIUM_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.6-27b
STT_MODEL=whisper-large-v3-turbo
FAST_REASONING_EFFORT=low
PREMIUM_REASONING_EFFORT=high
PREMIUM_CREDIT_COST=3
DAILY_FREE_MESSAGES=10
DAILY_FREE_PREMIUM_MESSAGES=5
# Images (generate + edit) have their own separate daily pool, not shared
# with premium chat — this is the one dial that controls real editing spend
DAILY_FREE_IMAGE_MESSAGES=5
# Referral program: REFERRAL_SIGNUP_BONUS is paid immediately to whoever
# clicks the link. REFERRAL_BONUS_MESSAGES is paid to the referrer once the
# referred account sends REFERRAL_MIN_MESSAGES real messages; REFERRAL_DAILY_CAP
# limits how many referrals can pay out per referrer per day (anti-fake-account abuse)
REFERRAL_SIGNUP_BONUS=5
REFERRAL_BONUS_MESSAGES=20
REFERRAL_MIN_MESSAGES=3
REFERRAL_DAILY_CAP=5
DB_PATH=assistant.db
# Days chat_log (admin support/audit trail) is kept before old rows are purged
CHATLOG_RETENTION_DAYS=30
# Max concurrent requests to Groq across all users (free tier is 30 RPM)
GROQ_MAX_CONCURRENT=5
# Timezone the daily quota resets in and unlimited-until is shown in (IANA name)
QUOTA_TZ=Europe/Moscow
# Monthly Stars subscription price — bump PRICE_VERSION in payments.py when changing
SUBSCRIPTION_PRICE_STARS=199
# Subscription is NOT unlimited — its own daily cap, bigger than the free tier
SUBSCRIPTION_DAILY_MESSAGES=30
SUBSCRIPTION_DAILY_PREMIUM_MESSAGES=15
# Promo-code bonus (see /promo_add) is also NOT unlimited — daily cap so a
# public promo link can't be farmed into unmetered free API spend
PROMO_BONUS_DAILY_MESSAGES=30
PROMO_BONUS_DAILY_PREMIUM_MESSAGES=5
# Comma-separated Telegram user IDs with access to /admin, /grant, /users, /chatlog
ADMIN_IDS=
